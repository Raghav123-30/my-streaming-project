POSTGRES_URL=postgresql://user:password@host:port/dbname?sslmode=require
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Cloudflare R2 Configuration
# Your Cloudflare Account ID (endpoint will be auto-constructed) or full R2_ENDPOINT
R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=your_r2_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Optional: 'auto' (default)
R2_REGION=auto
# Optional: Prefix for uploaded media files (defaults to 'media')
R2_PREFIX=media
# Optional: Public URL or custom domain (e.g., https://pub-xxx.r2.dev or https://media.yourdomain.com)
# If provided, file URLs will directly use this public CDN / custom domain
# R2_PUBLIC_URL=https://pub-xxx.r2.dev

